AUTI_PORT=8000
AUTI_SECRET_KEY=super-tajny-klucz-auti-serwera-dla-ha
AUTI_HA_URL=http://homeassistant.local:8123
AUTI_HA_TOKEN=your-token


# Optional LAN discovery settings
AUTI_MDNS_NAME="Auti Server"
